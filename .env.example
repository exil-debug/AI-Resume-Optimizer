# =============================================
# AI智能简历优化系统 - 环境变量配置示例
# 使用前复制为 .env 并根据实际环境修改
# =============================================

# ---------- API鉴权 ----------
# 支持的API提供商: deepseek / openai / siliconflow / custom
API_PROVIDER=deepseek
API_KEY=sk-your-api-key-here
API_BASE_URL=https://api.deepseek.com/v1
API_MODEL=deepseek-chat

# ---------- 模型参数调优 ----------
# 温控参数: 0.0(精确) ~ 1.0(创意), 推荐 0.7
LLM_TEMPERATURE=0.7
# 单次最大输出Token数
LLM_MAX_TOKENS=4096
# 请求超时时间(秒)
LLM_TIMEOUT=120

# ---------- 优化维度开关 (true/false) ----------
# 专业表述润色
ENABLE_POLISH=true
# 经历量化优化
ENABLE_QUANTIFY=true
# 岗位关键词匹配增强
ENABLE_KEYWORD_MATCH=true
# 格式规范化
ENABLE_FORMAT_NORMALIZE=true
# 语法纠错
ENABLE_GRAMMAR_FIX=true

# ---------- 输出风格 ----------
# 正式 / 简洁 / 详细
OUTPUT_STYLE=正式

# ---------- 长文本分段处理 ----------
# 单段最大字符数，超过将自动分段优化
CHUNK_MAX_LENGTH=3000

# ---------- 服务配置 ----------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8765